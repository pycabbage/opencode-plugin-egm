{
  "name": "opencode-plugin-egm",
  "version": "0.1.0",
  "private": true,
  "description": "EGM (Elephant-Goldfish Model) adapter for OpenCode v2",
  "type": "module",
  "scripts": {
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "prepare": "husky",
    "probe": "bun run tests/probe/run.ts",
    "e2e": "bun run tests/e2e/run.ts"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "oxlint --fix",
      "oxfmt"
    ],
    "tests/**/*.ts": [
      "oxlint --fix",
      "oxfmt"
    ],
    "{package.json,tsconfig.json,.oxlintrc.json,.oxfmtrc.json}": "oxfmt"
  }
}
