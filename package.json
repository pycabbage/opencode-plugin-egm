{
  "name": "opencode-plugin-egm",
  "version": "0.1.0",
  "description": "EGM (Elephant-Goldfish Model) adapter for OpenCode v2",
  "files": [
    "src",
    "vendor"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "bun test tests/",
    "probe": "bun run tests/probe/run.ts",
    "e2e": "bun run tests/e2e/run.ts",
    "prepare": "husky",
    "lint:md": "markdownlint-cli2 \"README.md\" \"docs/**/*.md\""
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.6",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "^0.24.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "oxlint --fix",
      "oxfmt"
    ],
    "tests/**/*.ts": [
      "oxlint --fix",
      "oxfmt"
    ],
    "{package.json,tsconfig.json,.oxlintrc.json,.oxfmtrc.json}": "oxfmt",
    "**/*.md": "markdownlint-cli2 --fix"
  }
}
